{
  "manifest_version": 3,
  "name": "ChatGPT Tool Slimmer",
  "version": "1.0.2",
  "description": "Slims old ChatGPT tool cards while preserving native conversation history loading and pagination.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "ChatGPT Tool Slimmer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "core.js",
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "dom-core.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
